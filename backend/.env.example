# Set privately, never commit actual values. Local setup writes its own ignored .env.
APP_ENVIRONMENT=development
DATABASE_URL=
FACADE_SECRET=
FRONTEND_ORIGIN=
# Enable only after migration and hosted WSS validation; see docs/04-design/realtime.md.
REALTIME_ENABLED=false
WEB_PUSH_ENABLED=false
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
# Only APP_ENVIRONMENT=production accepts the exact managed DNS hostname below.
# Production DATABASE_URL requires sslmode=verify-full and sslrootcert=system
# (libpq >=16), or an absolute readable PEM CA path. No host/service overrides.
PRODUCTION_DATABASE_HOST=
# Required only when selecting the corresponding isolated environment. DATABASE_URL
# remains the local development identity baseline in those environments. No fallback.
# TEST_DATABASE_URL=
# BENCHMARK_DATABASE_URL=
# RECOVERY_DATABASE_URL=
# POSTGRES_BIN=
# Local ClamAV defaults. Production also accepts a private service DNS name or IP;
# use a bare host here, not a URL or host:port. ClamD must stay on a trusted private network.
ANTIVIRUS_HOST=127.0.0.1
ANTIVIRUS_PORT=3310
