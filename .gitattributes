* text=auto eol=lf
# Preserve byte-for-byte upstream snapshots and their published provenance hashes.
docs/reference/** -text
# Retain upstream font-license bytes, including their published whitespace.
frontend/src/fonts/*-OFL.txt -text -whitespace
frontend/public/licenses/fonts/*-OFL.txt -text -whitespace
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary
