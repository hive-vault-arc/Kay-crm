* text=auto eol=lf
# Preserve byte-for-byte upstream snapshots and their published provenance hashes.
docs/reference/** -text
# Retain upstream font-license bytes, including their published whitespace.
frontend/src/fonts/*-OFL.txt -text -whitespace
frontend/public/licenses/fonts/*-OFL.txt -text -whitespace
# Retain unmodified upstream codec licence text, including its whitespace.
frontend/public/licenses/heic/EMSCRIPTEN-LICENSE.txt -text -whitespace
frontend/public/licenses/heic/*GPL-3.0.txt -text -whitespace
frontend/public/licenses/heic/lib*-COPYING.txt -text -whitespace
frontend/public/licenses/webp/EMSCRIPTEN-LICENSE.txt -text -whitespace
frontend/public/licenses/webp/libwebp-COPYING.txt -text -whitespace
frontend/public/licenses/webp/libwebp-PATENTS.txt -text -whitespace
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.heic binary
*.heif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary
