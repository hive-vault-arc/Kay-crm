{
  "name": "kay-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "node scripts/icon-inventory.mjs --check && eslint src tests scripts next.config.ts playwright*.ts *.mjs --max-warnings=0",
    "icons:check": "node scripts/icon-inventory.mjs --check",
    "typecheck": "next typegen && tsc --noEmit",
    "security:check": "node ../.github/scripts/dependency-audit.mjs",
    "test:e2e": "playwright test",
    "test:chrome": "playwright test --config=playwright.chrome.config.ts --headed --workers=1"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@number-flow/react": "0.6.2",
    "@tanstack/react-table": "8.21.3",
    "@visx/event": "4.0.0",
    "@visx/gradient": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-array": "3.2.4",
    "motion": "14.3.0",
    "next": "16.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.30",
    "shadcn": "4.21.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
