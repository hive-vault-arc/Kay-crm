{
  "name": "kay-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-heic.mjs && node scripts/dev.mjs",
    "build": "node scripts/prepare-heic.mjs && next build",
    "start": "node scripts/start.mjs",
    "lint": "node scripts/icon-inventory.mjs --check && node scripts/button-inventory.mjs && eslint src tests scripts next.config.ts playwright*.ts *.mjs --max-warnings=0",
    "buttons:check": "node scripts/button-inventory.mjs",
    "icons:check": "node scripts/icon-inventory.mjs --check",
    "typecheck": "next typegen && tsc --noEmit",
    "security:check": "node ../.github/scripts/dependency-audit.mjs",
    "test:unit": "node scripts/test-facade.mjs",
    "history:check": "node scripts/check-history-bootstrap.mjs",
    "test:e2e": "playwright test",
    "test:chrome": "playwright test --config=playwright.chrome.config.ts --headed --workers=1",
    "test:realtime": "playwright test --config=playwright.realtime.config.ts --headed --workers=1"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@number-flow/react": "0.6.2",
    "@tanstack/react-table": "8.21.3",
    "@visx/event": "4.0.0",
    "@visx/gradient": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-array": "3.2.5",
    "d3-shape": "3.2.1",
    "lenis": "1.3.27",
    "motion": "14.4.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
