# Server-only values. Never prefix these with NEXT_PUBLIC_.
# Set API_BASE_URL to the backend HTTPS origin only (no /api/v1 path).
# Remote HTTPS uses Node's normal CA/hostname verification; omit API_CA_FILE on Vercel.
# The existing local HTTPS workflow still requires API_CA_FILE for its local CA.
API_BASE_URL=
FACADE_SECRET=
API_CA_FILE=
FRONTEND_ORIGIN=https://localhost:3000
# KAY_UI_CHECKS is set only by Playwright's isolated development server.
